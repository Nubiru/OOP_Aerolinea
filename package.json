{
  "name": "sistema-base-oop",
  "version": "1.0.0",
  "description": "Sistema OOP_Aerolinea - práctica universitaria de POO",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "ts-node backend/index.ts",
    "dev:frontend": "serve frontend -l 5173 --no-clipboard",
    "demo": "ts-node backend/demo.ts",
    "seed": "ts-node backend/seed.ts",
    "verify": "ts-node backend/verify.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "type": "commonjs",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "serve": "^14.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
